    Serial.println(WiFi.macAddress());                                      // Виведення апаратної адреси бездротового адаптера
  }                                                                         // Завершення блоку виведення даних підключеної мережі
  else                                                                      // Гілка виведення статусу за відсутності мережі
  {                                                                         // Блок дій у разі відсутності зв'язку
    Serial.println("Status: Disconnected");                                 // Друк повідомлення про розірване з'єднання
  }                                                                         // Завершення перевірки статусу зв'язку
}                                                                           // Завершення функції друку інформації про мережу

void sendToCloud()                                                          // Функція передачі телеметричних даних у хмару
{                                                                           // Функція передачі сформованого пакета в хмарне сховище
  if (!wifi_ok)                                                             // Перевірка готовності мережі перед формуванням запиту
  {                                                                         // Перевірка наявності підключення перед відправкою
    Serial.println("[ThingSpeak] Skipped: WiFi offline");                   // Повідомлення про скасування відправки без мережі
    return;                                                                 // Достроковий вихід за відсутності мережевого з'єднання
  }                                                                         // Завершення блоку перевірки
  HTTPClient http;                                                          // Створення об'єкта виконання запитів клієнта
  String url = String(SERVER);                                              // Формування базової частини інтернет адреси
  url += "?api_key=" + String(API_KEY);                                     // Додавання секретного ключа доступу каналу
  url += "&field1=" + String(rawTemperature, 2);                            // Додавання першого поля первинної температури
  url += "&field2=" + String(currentTemperature, 2);                        // Додавання другого поля очищеної температури
  url += "&field3=" + String(relayState ? 1 : 0);                           // Додавання третього поля стану реле
  url += "&field4=" + String(aiDetector.getAnomalyScorePercent(), 1);       // Додавання четвертого поля оцінки аномалії
  url += "&field5=" + String(measurementCount);                             // Додавання п'ятого поля номера виміру
  url += "&field6=" + String((int)aiDetector.getState());                   // Додавання шостого поля коду стану пацієнта
  Serial.println("Sending data to ThingSpeak...");                          // Повідомлення в консоль про початок відправки
  http.begin(url);                                                          // Ініціалізація інтернет з'єднання за сформованою адресою
  http.setTimeout(5000);                                                    // Встановлення ліміту очікування відповіді п'ять секунд
  int code = http.GET();                                                    // Виконання запиту отримання відповіді від сервера
  if (code == 200)                                                          // Перевірка отримання коду успішної відповіді сервера
  {                                                                         // Перевірка успішності отримання відповіді
    String response = http.getString();                                     // Зчитування рядка відповіді сервера
    Serial.print("Success! Entry ID: ");                                    // Друк підтвердження успішного збереження запису
    Serial.println(response);                                               // Виведення ідентифікатора створеного запису в хмарі
  }                                                                         // Завершення обробки позитивної відповіді сервера
  else                                                                      // Гілка обробки помилки мережевого протоколу
  {                                                                         // Обробка ситуації виникнення мережевої помилки
    Serial.print("HTTP Error: ");                                           // Друк префіксу помилки мережевого протоколу
    Serial.println(code);                                                   // Виведення числового коду помилки сервера
  }                                                                         // Завершення аналізу відповіді сервера
  http.end();                                                               // Закриття мережевого з'єднання та звільнення пам'яті
  Serial.println();                                                         // Друк порожнього рядка для візуального відступу
}                                                                           // Завершення функції відправки даних у хмару