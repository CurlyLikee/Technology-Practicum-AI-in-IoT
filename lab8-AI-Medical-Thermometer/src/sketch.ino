void printWiFiInfo()                                                        // Функція виведення параметрів поточного з'єднання
{                                                                           // Функція відображення параметрів мережі
  Serial.println("\r\n WIFI INFO ");                                        // Друк шапки інформації про мережу
  if (wifi_ok)                                                              // Перевірка прапорця активності мережевого з'єднання
  {                                                                         // Перевірка наявності активного мережевого з'єднання
