  display.fillRect(0, 0, SCREEN_WIDTH, 14, SSD1306_WHITE);    // Формування верхньої прямокутної інверсної плашки
  display.setTextColor(SSD1306_BLACK);                        // Встановлення чорного кольору літер для контрасту на білому фоні
  display.setTextSize(1);                                     // Встановлення одиничного кегля шрифту
  display.setCursor(4, 3);                                    // Зміщення координат друку всередину верхньої плашки
  display.print("MODE: ");                                    // Виведення текстової позначки назви режиму
  display.print(profileName);                                 // Виведення найменування активного профілю

  display.setTextColor(SSD1306_WHITE);                        // Перемикання кольору на білий для основного інформаційного поля
  display.setCursor(0, 20);                                   // Встановлення координат початку другого інформаційного рядка
  display.print("Status : HID Online");                       // Відображення статусу емуляції пристрою введення

  display.setCursor(0, 32);                                   // Встановлення координат початку третього інформаційного рядка
  display.print("Context: ");                                 // Друк підпису параметра контексту застосунків
  display.println(getAIContext());                            // Виведення назви робочого контексту активного профілю

  display.setCursor(0, 44);                                   // Встановлення координат четвертого інформаційного рядка
  display.print("Keys   : 16 Ready");                         // Відображення готовності всіх клавіш до спрацьовування

  display.drawFastHLine(0, 54, SCREEN_WIDTH, SSD1306_WHITE);  // Побудова горизонтальної лінії візуального розмежування
  display.setCursor(0, 56);                                   // Встановлення координат нижнього рядка підказки
  display.print("Press B9: Next Profile");                    // Текст підказки щодо призначення клавіші перемикання

  display.display();                                          // Оновлення зображення на фізичній матриці дисплея
}                                                             // Закриття функції побудови панелі

void showAISuggestion(const char *suggestion)                 // Початок функції виводу інтелектуальної підказки на екран
{                                                             // Відкриття блоку показу підказки
