void connectWiFi()                                                          // Початок оголошення підпрограми підключення до бездротової мережі
{                                                                           // Відкриття тіла функції бездротового зв'язку
  Serial.print("Connecting to Wi-Fi");                                      // Виведення тексту початку спроби з'єднання у термінал
  WiFi.begin(WIFI_SSID, WIFI_PASS);                                         // Старт процедури підключення радіомодуля до точки доступу
  unsigned long startTime = millis();                                       // Фіксація початкового часу для контролю тривалості спроби
  while (WiFi.status() != WL_CONNECTED && millis() - startTime < 8000)      // Опитування статусу мережі з обмеженням за часом
  {                                                                         // Відкриття циклу очікування авторизації
    delay(500);                                                             // Очікування пів секунди між кроками перевірки стану
    Serial.print(".");                                                      // Виведення крапки індикації процесу з'єднання
  }                                                                         // Закриття циклу очікування авторизації
  if (WiFi.status() == WL_CONNECTED)                                        // Перевірка факту підтвердження з'єднання з мережею
  {                                                                         // Відкриття гілки успішного підключення
    Serial.println();                                                       // Чистий перехід на новий рядок
    Serial.println("Wi-Fi connected! IP: " + WiFi.localIP().toString());    // Виведення отриманої адреси вузла у мережі
  }                                                                         // Закриття гілки успішного підключення
  else                                                                      // Перехід до альтернативної гілки у разі тайм-ауту
  {                                                                         // Відкриття гілки обробки відсутності мережі
    Serial.println("\nWi-Fi unavailable; continuing offline");              // Сповіщення про перехід пристрою в автономну роботу
    WiFi.disconnect(true);                                                  // Повне відключення модуля бездротового зв'язку
  }                                                                         // Закриття гілки обробки відсутності мережі
}                                                                           // Закриття функції підключення до бездротової мережі

void sendTelemetryToThingSpeak()                                            // Початок оголошення функції відправки даних у хмару
{                                                                           // Відкриття тіла функції відправки телеметрії
  if (millis() - lastThingSpeakSend < THINGSPEAK_INTERVAL)                  // Контроль дотримання мінімального періоду між транзакціями
  {                                                                         // Відкриття гілки дострокового повернення
    return;                                                                 // Завершення виконання за відсутності потреби передачі
  }                                                                         // Закриття гілки дострокового повернення

  if (WiFi.status() == WL_CONNECTED)                                         // Перевірка наявності активного зв'язку перед передачею
  {                                                                          // Відкриття блоку мережевого обміну
    HTTPClient http;                                                         // Створення локального екземпляра мережевого клієнта

    String url = String(THINGSPEAK_URL) + "?api_key=" + THINGSPEAK_API_KEY + // Складання базової адреси та ключа запису
                 "&field1=" + String(lastSentButton) +                       // Додавання параметра першого каналу з кодом кнопки
                 "&field2=" + String(currentProfile) +                       // Додавання параметра другого каналу з індексом режиму
                 "&field3=" + String(patternData.totalPresses);              // Додавання параметра третього каналу з лічильником дій

    http.begin(url);                                                         // Ініціалізація HTTP клієнта за сформованим посиланням
    int httpResponseCode = http.GET();                                       // Виконання мережевого запиту методом GET з фіксацією відповіді

    if (httpResponseCode > 0)                                                // Перевірка отримання коректного статусу від сервера
    {                                                                        // Відкриття блоку звіту про успіх
      Serial.println("----------------------------------------");            // Друк верхньої межі текстового звіту
      Serial.println("[ThingSpeak HTTP] Telemetry successfully published!"); // Інформаційне повідомлення про успішну фіксацію
      Serial.print("Payload -> Last Key: ");                                 // Виведення підпису значення коду клавіші
      Serial.print(lastSentButton);                                          // Виведення збереженого коду клавіші
      Serial.print(" | Profile ID: ");                                       // Виведення підпису ідентифікатора профілю
      Serial.print(currentProfile);                                          // Виведення поточного номера конфігурації дій
      Serial.print(" | Total Presses: ");                                    // Виведення підпису підрахунку подій
      Serial.println(patternData.totalPresses);                              // Виведення загальної кількості дій
      Serial.println("----------------------------------------");            // Друк нижньої межі текстового звіту
    }                                                                         // Закриття блоку звіту про успіх
    else                                                                           // Перехід до обробки ситуації апаратного або логічного збою
    {                                                                              // Відкриття блоку звіту про помилку
      Serial.print("[ThingSpeak HTTP] Failed to publish telemetry. Error code: "); // Виведення тексту сповіщення про збій зв'язку
      Serial.println(httpResponseCode);                                            // Виведення числового коду помилки клієнта
    }                                                                              // Закриття блоку звіту про помилку
    http.end();                                                                    // Звільнення пам'яті та закриття клієнтської сесії
  }                                                                                // Закриття блоку мережевого обміну

  lastThingSpeakSend = millis();                                                   // Оновлення часу здійснення попереднього звернення до сервера
}                                                                                  // Закриття функції відправки даних у хмару

