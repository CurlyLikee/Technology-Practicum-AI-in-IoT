}                                                             // Закриття функції індикації дії

void initButtons()                                            // Початок оголошення підпрограми конфігурації матриці кнопок
{                                                             // Відкриття тіла функції налаштування ліній матриці
  for (int i = 0; i < 4; i++)                                 // Організація циклу перебору чотирьох ліній вихідних сигналів
  {                                                           // Відкриття циклу налаштування рядків
    pinMode(rowPins[i], OUTPUT);                              // Встановлення режиму виходу для лінії рядка
    digitalWrite(rowPins[i], HIGH);                           // Встановлення високого рівня пасивного стану
  }                                                           // Закриття циклу налаштування рядків

  for (int i = 0; i < 4; i++)                                 // Організація циклу перебору чотирьох ліній вхідних сигналів
  {                                                           // Відкриття циклу налаштування стовпчиків
    pinMode(colPins[i], INPUT_PULLUP);                        // Конфігурація входу з внутрішнім підтягувальним резистором
  }                                                           // Закриття циклу налаштування стовпчиків

  for (int row = 0; row < 4; row++)                           // Організація циклу обходу рядків масивів збереження стану
  {                                                           // Відкриття зовнішнього циклу рядків
    for (int col = 0; col < 4; col++)                         // Організація циклу обходу стовпчиків масивів збереження стану
    {                                                         // Відкриття внутрішнього циклу стовпчиків
      lastButtonState[row][col] = HIGH;                       // Ініціалізація попереднього значення високим рівнем
      buttonState[row][col] = HIGH;                           // Ініціалізація підтвердженого значення високим рівнем
    }                                                         // Закриття внутрішнього циклу стовпчиків
  }                                                           // Закриття зовнішнього циклу рядків

  Serial.println("Matrix buttons initialized");         // Виведення повідомлення про завершення конфігурації матриці
}                                                             // Закриття функції налаштування ліній матриці

int readMatrixButton(int row, int col)                        // Початок функції зчитування окремого перетину матриці з фільтрацією брязкоту
{                                                             // Відкриття тіла функції опитування клавіші
  if (row < 0 || row >= 4 || col < 0 || col >= 4)             // Перевірка виходу параметрів за межі фізичних розмірів матриці
  {                                                           // Відкриття блоку некоректних координат
    return HIGH;                                              // Повернення значення розімкненого стану для некоректних індексів
  }                                                           // Закриття блоку некоректних координат

  for (int i = 0; i < 4; i++)                                 // Цикл встановлення активного логічного рівня на обраній лінії
  {                                                           // Відкриття циклу керування рядками
    digitalWrite(rowPins[i], (i == row) ? LOW : HIGH);        // Притискання цільового рядка до нуля та подача одиниці на решту
  }                                                           // Закриття циклу керування рядками

  delayMicroseconds(10);                                        // Затримка для стабілізації перехідного процесу напруги на контактах

  int reading = digitalRead(colPins[col]);                      // Фіксація миттєвого логічного рівня на обраному стовпчику

  if (reading != lastButtonState[row][col])                     // Виявлення факту зміни електричного рівня сигналу
  {                                                             // Відкриття гілки зміни сигналу
    lastDebounceTime[row][col] = millis();                      // Оновлення системного часу початку процесу брязкоту
    lastButtonState[row][col] = reading;                        // Запам'ятовування нового значення для наступних перевірок
  }                                                             // Закриття гілки зміни сигналу

  if ((millis() - lastDebounceTime[row][col]) > DEBOUNCE_DELAY) // Контроль перевищення тривалості стабільності сигналу над часом брязкоту
  {                                                             // Відкриття блоку фіксації стабільного сигналу
    if (reading != buttonState[row][col])                       // Перевірка зміни підтвердженого рівня відносно попереднього
    {                                                           // Відкриття блоку оновлення підтвердженого стану
      buttonState[row][col] = reading;                          // Збереження нового стабільного значення контакту
      return buttonState[row][col];                             // Повернення оновленого логічного стану лінії
    }                                                           // Закриття блоку оновлення підтвердженого стану
  }                                                             // Закриття блоку фіксації стабільного сигналу
  return HIGH;                                                  // Повернення високого рівня за відсутності підтверджених змін
}                                                               // Закриття функції опитування клавіші

bool isMatrixButtonPressed(int row, int col)                    // Початок функції перевірки факту замикання контакту
{                                                               // Відкриття тіла функції перевірки натискання
  return readMatrixButton(row, col) == LOW;                     // Повернення істини у разі виявлення активного низького рівня
}                                                               // Закриття функції перевірки натискання

int getPressedButton()                                          // Початок функції послідовного сканування всіх кнопок клавіатури
{                                                               // Відкриття тіла функції загального сканування
  for (int row = 0; row < 4; row++)                             // Зовнішній перебір рядків матриці
  {                                                             // Відкриття циклу рядків
    for (int col = 0; col < 4; col++)                           // Внутрішній перебір стовпчиків матриці
    {                                                           // Відкриття циклу стовпчиків
      if (isMatrixButtonPressed(row, col))                      // Перевірка наявності натискання у поточній комірці
      {                                                         // Відкриття умови виявлення активної кнопки
        return row * 4 + col;                                   // Розрахунок та повернення лінійного номера знайденої кнопки
      }                                                         // Закриття умови виявлення активної кнопки
    }                                                           // Закриття циклу стовпчиків
  }                                                             // Закриття циклу рядків
  return -1;                                                    // Повернення ознаки відсутності будь-яких натиснутих кнопок
}                                                               // Закриття функції загального сканування

const char *getMacro(int buttonIndex)                           // Початок функції вибірки команди за номером клавіші
{                                                               // Відкриття тіла функції вибірки команди
  if (buttonIndex >= 0 && buttonIndex < NUM_BUTTONS)            // Контроль коректності діапазону номера кнопки
  {                                                             // Відкриття блоку валідного індексу
    return profiles[currentProfile].macros[buttonIndex];        // Повернення вказівника на макрос активної конфігурації
  }                                                             // Закриття блоку валідного індексу
  return "";                                                    // Повернення порожнього тексту у разі неприпустимого індексу
}                                                               // Закриття функції вибірки команди

void nextProfile()                                              // Початок процедури зміни активного набору макросів
{                                                               // Відкриття тіла функції зміни набору
  currentProfile = (currentProfile + 1) % NUM_PROFILES;         // Циклічний інкремент індексу профілю за модулем
}                                                               // Закриття функції зміни набору

void sendMacroCommand(const char *macro)                        // Початок функції надсилання команди на комп'ютер
{                                                               // Відкриття тіла функції надсилання команди
  Serial.print("[HID COMMAND] Executed: ");                     // Виведення службового маркера виконання в термінал
  Serial.println(macro);                                        // Друк надісланої послідовності дій у послідовний порт
}                                                               // Закриття функції надсилання команди

void handleButtonPress(int buttonIndex)                         // Початок процедури обробки сигналу від натиснутої клавіші
{                                                               // Відкриття тіла функції диспетчеризації події
  if (buttonIndex < 0 || buttonIndex >= NUM_BUTTONS)            // Перевірка діапазону вхідного індексу кнопки
  {                                                             // Відкриття блоку відсікання помилкових кодів
    return;                                                     // Переривання виконання при некоректному значенні номера
  }                                                             // Закриття блоку відсікання помилкових кодів

  lastSentButton = buttonIndex + 1;                             // Фіксація номера останньої клавіші для відправки телеметрії

  const char *macro = getMacro(buttonIndex);                    // Отримання назви закріпленої команди з таблиці
  recordButtonPress(buttonIndex);                               // Передача інформації про натискання у статистичний аналізатор

  Serial.print("Button ");                                      // Друк префікса номера елемента
  Serial.print(buttonIndex + 1);                                // Друк порядкового номера клавіші від одиниці
  Serial.print(" pressed - Macro: ");                           // Друк зв'язувального фрагмента тексту
  Serial.println(macro);                                        // Виведення назви призначеної команди у консоль

  sendMacroCommand(macro);                                      // Виклик функції виконання команди вхідного інтерфейсу
  showButtonPress(buttonIndex, macro);                          // Запуск індикації спрацьовування на екрані пристрою
}                                                               // Закриття функції диспетчеризації події

void handleProfileSwitch()                                                      // Початок підпрограми контролю службової клавіші зміни розкладки
{                                                                               // Відкриття блоку обробки перемикання
  static bool btn9WasPressed = false;                                           // Збереження стану перемикача між викликами циклу
  bool isDown = isMatrixButtonPressed(PROFILE_SWITCH_ROW, PROFILE_SWITCH_COL);  // Зчитування фізичного рівня на кнопці перемикання

  if (isDown && !btn9WasPressed)                            // Фіксація моменту первинного замикання контактів
  {                                                         // Відкриття блоку спрацьовування фронту
    btn9WasPressed = true;                                  // Блокування повторного виклику до моменту відпускання
    nextProfile();                                          // Перемикання на наступний за чергою профіль команд
    showMacroGrid(getCurrentProfileName());                 // Оновлення робочого інтерфейсу на дисплеї

    Serial.println("=================================");    // Виведення лінії оформлення блоку
    Serial.print("PROFILE SWITCHED TO: ");                  // Текст повідомлення про зміну робочого режиму
    Serial.println(getCurrentProfileName());                // Виведення імені активного профілю
    Serial.println("=================================");    // Виведення завершальної лінії оформлення
  }                                                         // Закриття блоку спрацьовування фронту
  else if (!isDown)                                         // Фіксація розмикання контактів кнопки перемикання
  {                                                         // Відкриття блоку відновлення готовності
    btn9WasPressed = false;                                 // Дозвіл на наступне спрацьовування перемикача
  }                                                         // Закриття блоку відновлення готовності
}                                                           // Закриття підпрограми контролю службової клавіші

void updateDisplay()                                        // Початок процедури скидання тимчасової індикації екрана
{                                                           // Відкриття тіла функції поновлення екрана
  static unsigned long lastDisplayUpdate = 0;               // Збереження мітки часу попереднього скидання
  static int lastProfile = -1;                              // Збереження індексу профілю попереднього кадру

  if (currentProfile != lastProfile || millis() - lastDisplayUpdate > 5000) // Контроль зміни режиму або виходу за інтервал утримання кадру
  {                                                                         // Відкриття блоку перемальовки головного табло
    showMacroGrid(getCurrentProfileName());                                 // Відображення головного інформаційного табло
    lastProfile = currentProfile;                                           // Синхронізація запам'ятованого значення профілю
    lastDisplayUpdate = millis();                                           // Оновлення мітки часу останнього виводу табло
  }                                                                         // Закриття блоку перемальовки головного табло
}                                                                           // Закриття функції поновлення екрана

unsigned long lastAISuggestionTime = 0;                                     // Змінна збереження часу попередньої генерації підказки

void showAISuggestions()                                                    // Початок підпрограми формування та відображення порад
{                                                                           // Відкриття блоку роботи з порадами
  if (millis() - lastAISuggestionTime >= AI_SUGGESTION_INTERVAL)            // Перевірка настання планового інтервалу для нової підказки
  {                                                                         // Відкриття блоку періодичного опитування аналітики
    const char *context = detectContext();                                  // Отримання визначеного системою контексту з аналітичного модуля
    const char *suggestion = generateSuggestion(context);                   // Складання текстової рекомендації на основі виявленого контексту

    Serial.print("AI Context: ");                                           // Виведення підпису параметра типу поточного контексту
    Serial.println(context);                                                // Виведення визначеного типу контексту в консоль
    Serial.print("AI Suggestion: ");                                        // Виведення підпису згенерованої рекомендації
    Serial.println(suggestion);                                             // Друк тексту підказки для оптимізації роботи

    showAISuggestion(suggestion);                                           // Виведення сформованої підказки на екран дисплея
    lastAISuggestionTime = millis();                                        // Фіксація мітки часу останнього виклику генерації
  }                                                                         // Закриття блоку періодичного опитування аналітики
}                                                                           // Закриття підпрограми формування порад

void setup()                                                                // Головна підпрограма налаштування системи при запуску
{                                                                           // Відкриття блоку конфігурації платформи
  Serial.begin(115200);                                                     // Налаштування швидкості інформаційного каналу передачі даних
  delay(1000);                                                              // Пауза для встановлення стабільного живлення компонентів

  Serial.println("=================================");                      // Друк верхньої рамки стартового сповіщення
  Serial.println("AI Macro Pad");                                           // Виведення офіційного найменування пристрою
  Serial.println("=================================");                      // Друк розділювача стартового сповіщення

  connectWiFi();                                            // Виклик підпрограми підключення до бездротової мережі
  initDisplay();                                            // Виклик процедури конфігурації модуля відображення інформації
  showWelcomeScreen();                                      // Виведення початкової графічної заставки
  initButtons();                                            // Налаштування виводів мікроконтролера під роботу з матрицею кнопок
  initAI();                                                 // Ініціалізація внутрішніх структур модуля машинного навчання

  showMacroGrid(getCurrentProfileName());                   // Виведення базового інформаційного табло

  Serial.println("System ready!");                          // Інформаційне сповіщення про повну готовність до роботи
  Serial.println("Press any button to send macros");        // Інструкція з надсилання команд у термінал
  Serial.println("Press button 9 to switch profiles");      // Інструкція щодо перемикання наборів дій
  Serial.println("=================================");      // Друк нижньої межі сповіщення готовності
}                                                           // Закриття підпрограми конфігурації платформи

void loop()                                                 // Головний циклічний процес виконання системних завдань
{                                                           // Відкриття тіла головного нескінченного циклу
  sendTelemetryToThingSpeak();                              // Перевірка таймера та вивантаження даних телеметрії на сервер

  int pressedButton = getPressedButton();                                 // Зчитування коду поточної затиснутої кнопки матриці
  int switchButtonIndex = PROFILE_SWITCH_ROW * 4 + PROFILE_SWITCH_COL;    // Визначення індексу кнопки перемикання режимів

  if (pressedButton == switchButtonIndex)                                 // Обробка події кнопки зміни профілю після єдиного сканування матриці
  {                                                                       // Відкриття обробки службової кнопки
    nextProfile();                                                        // Перехід до наступного профілю рівно один раз за натискання
    showMacroGrid(getCurrentProfileName());                               // Оновлення інформації на OLED після перемикання
    Serial.print("PROFILE SWITCHED TO: ");                                // Виведення одного короткого повідомлення про новий профіль
    Serial.println(getCurrentProfileName());                              // Друк назви активного профілю
  }                                                                       // Закриття обробки службової кнопки
  else if (pressedButton != -1)                                           // Обробка звичайних кнопок після єдиного сканування матриці
  {                                                                       // Відкриття обробки кліку робочої кнопки
    handleButtonPress(pressedButton);                                     // Виконання та індикація макросу для зафіксованої кнопки
  }                                                                       // Закриття обробки кліку робочої кнопки

  updateDisplay();                                                        // Планове поновлення стану табло та очищення після індикації дії
  showAISuggestions();                                                    // Опитування таймера та виведення рекомендацій оптимізації

  delay(10);                                                              // Апаратне розвантаження обчислювального ядра між ітераціями циклу
}                                                                         // Закриття головного нескінченного циклу