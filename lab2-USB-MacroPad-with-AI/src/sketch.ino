void initDisplay()                                                          // Початок оголошення підпрограми налаштування пристрою відображення
{                                                                           // Відкриття тіла функції налаштування дисплея
  Wire.begin(21, 22);                                                       // Конфігурація ліній даних та тактування інтерфейсу I2C

  displayAvailable = display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS);   // Спроба старту панелі за основною адресою
  if (!displayAvailable)                                                    // Перевірка невдачі запуску за основним каналом адресації
  {                                                                         // Відкриття блоку спроби роботи з резервною адресою
    displayAvailable = display.begin(SSD1306_SWITCHCAPVCC, 0x3D);           // Спроба запуску дисплея за альтернативною адресою
  }                                                                         // Закриття блоку перевірки резервної адреси
  if (!displayAvailable)                                                    // Перевірка відсутності відповіді екрана за обома адресами
  {                                                                         // Відкриття блоку сповіщення про збій
    Serial.println(F("OLED not found; buttons remain active"));             // Повідомлення про роботу виключно блоку клавіш
    return;                                                                 // Завершення виконання функції у разі відсутності модуля
  }                                                                         // Закриття блоку сповіщення про збій

  display.clearDisplay();                       // Заповнення буфера порожніми значеннями пікселів
  display.setTextSize(1);                       // Встановлення базового масштабу символів шрифту
  display.setTextColor(SSD1306_WHITE);          // Встановлення білого кольору відображення інформації
  display.setCursor(0, 0);                      // Повернення курсора на початок системи координат
  display.display();                            // Запис початкового буфера в пам'ять контролера екрана

  Serial.println("OLED display initialized");   // Підтвердження коректного запуску блоку виводу інформації
}                                               // Закриття функції налаштування дисплея

void showWelcomeScreen()                        // Початок функції показу початкової заставки
{                                               // Відкриття блоку відображення заставки
  if (!displayAvailable)                        // Перевірка наявності зв'язку з екраном
  {                                             // Відкриття гілки блокування роботи з відсутнім екраном
    return;                                     // Переривання процедури за відсутності підключення дисплея
  }                                             // Закриття гілки блокування
  display.clearDisplay();                       // Очищення робочого буфера перед побудовою тексту
  display.setTextSize(1);                       // Встановлення стандартного розміру шрифту для заставки
  display.setTextColor(SSD1306_WHITE);          // Вибір білого кольору літер
  display.setCursor(0, 0);                      // Встановлення координат виводу у вихідну позицію
  display.println("Smart Macro Pad");           // Виведення заголовка проєкту на екран
  display.println("16 Keys + AI");              // Виведення підпису апаратної структури та інтелектуальної системи
  display.println("Ready!");                    // Повідомлення про готовність модуля до зчитування клавіш
  display.display();                            // Передача буфера на панель для фізичного показу
  delay(2000);                                  // Очікування дві секунди для візуального контролю запуску
}                                               // Закриття блоку відображення заставки

void showMacroGrid(const char *profileName)     // Початок функції відмальовки базової інформаційної панелі
