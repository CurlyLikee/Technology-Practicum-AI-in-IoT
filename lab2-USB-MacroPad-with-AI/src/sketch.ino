}                                                             // Закриття блоку показу підказки

void showButtonPress(int buttonIndex, const char *macro)      // Початок функції демонстрації натискання кнопки
{                                                             // Відкриття тіла функції індикації дії
  if (!displayAvailable)                                      // Перевірка можливості роботи з апаратним екраном
  {                                                           // Відкриття умови блокування
