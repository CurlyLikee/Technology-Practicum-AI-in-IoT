  oled.setTextSize(1);                                    // Встановлення системного шрифту одиничного розміру
  oled.setCursor(0, 0);                                   // Переміщення на верхню границю графічного поля
  oled.println(F("--- AI ENERGY TIP ---"));               // Виведення заголовка модуля порад енергоспоживання
