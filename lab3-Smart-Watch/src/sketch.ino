const char *activityName(ActivityType a)              // Функція перетворення числового типу активності в рядок
{                                                     // Відкриття функції перетворення типу активності
  switch (a)                                          // Оператор вибору гілки відповідно до стану активності
  {                                                   // Відкриття блоку вибору типу активності
  case ACTIVITY_IDLE:                                 // Обробка стану спокою
    return "IDLE";                                    // Повернення текстового імені стану спокою
  case ACTIVITY_WALKING:                              // Обробка стану ходьби
    return "WALKING";                                 // Повернення текстового імені стану повільної ходьби
  case ACTIVITY_RUNNING:                              // Обробка стану бігу
    return "RUNNING";                                 // Повернення текстового імені стану інтенсивного бігу
  case ACTIVITY_FALL:                                 // Обробка стану падіння
    return "!! FALL !!";                              // Повернення тривожного повідомлення детекції падіння
  default:                                            // Обробка невідомого типу активності
    return "UNKNOWN";                                 // Повернення статусу неідентифікованого руху
  }                                                   // Завершення перемикача вибору імені активності
}                                                     // Завершення функції перетворення типу активності

void initOLED()                                       // Функція початкового налаштування та запуску дисплея
{                                                     // Відкриття процедури ініціалізації дисплея
  if (!oled.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR))   // Спроба запуску контролера дисплея на шині
  {                                                   // Відкриття блоку обробки помилки запуску дисплея
    Serial.println(F("\r[OLED] Init FAILED"));        // Повідомлення в термінал про помилку ініціалізації
    oledAvailable = false;                            // Фіксація апаратного збою інтерфейсу виведення
    return;                                           // Дострокове переривання функції при помилці зв'язку
  }                                                   // Завершення блоку обробки невдалої ініціалізації дисплея
  oledAvailable = true;                               // Встановлення статусу повної готовності екрана
  oled.clearDisplay();                                // Очищення буфера пам'яті графічного адаптера
  oled.setTextSize(1);                                // Встановлення базового масштабу графічного шрифту
  oled.setTextColor(SSD1306_WHITE);                   // Встановлення білого монохромного кольору відображення
  oled.setCursor(10, 20);                             // Переміщення курсора у стартові координати заголовка
  oled.println(F("Activity Tracker"));                // Виведення стартової назви розробленої системи
  oled.setCursor(20, 35);                             // Встановлення координат підрядка стану запуску
  oled.println(F("Starting..."));                     // Виведення інформаційного повідомлення завантаження
  oled.display();                                     // Запис вмісту кадрового буфера безпосередньо в дисплей
  Serial.println(F("\r[OLED] OK (128x64 I2C)"));      // Звіт у термінал про успішний старт модуля дисплея
}                                                     // Завершення процедури ініціалізації дисплея

void initMPU()                                        // Функція конфігурування модуля датчика прискорення та гіроскопа
{                                                     // Відкриття процедури налаштування сенсора руху
  if (!mpu.begin())                                   // Перевірка успішності запуску сенсора
  {                                                                                 // Спроба виявлення та запуску сенсора на шині даних
    Serial.println(F("\r[MPU6050] Init FAILED! Using fallback motion values."));    // Виведення попередження про відсутність зв'язку
    mpuAvailable = false;                                                           // Перехід на використання програмних значень руху
    return;                                                                         // Достроковий вихід із процедури налаштування сенсора
  }                                                                                 // Завершення обробки відсутності модуля сенсора
  mpuAvailable = true;                                                              // Фіксація коректного старту апаратного вимірювача
  mpu.setAccelerometerRange(MPU6050_RANGE_8_G);                                     // Налаштування діапазону вимірювання прискорень
  mpu.setGyroRange(MPU6050_RANGE_500_DEG);                                          // Налаштування шкали вимірювання кутової швидкості
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);                                       // Конфігурація смуги пропускання низькочастотного фільтра
  Serial.println(F("\r[MPU6050] OK (8G / 500dps / 21Hz)"));                         // Виведення підтвердження встановлення параметрів датчика
}                                                                                   // Завершення процедури налаштування сенсора руху

