  oled.printf("Accel: %.1f m/s2\n", accelMag);    // Відображення повної розрахованої магнітуди прискорення

  oled.drawLine(0, 52, 127, 52, SSD1306_WHITE);                                                     // Проведення горизонтальної роздільної лінії інтерфейсу
  oled.setCursor(0, 55);                                                                            // Перехід у нижній статусно-навігаційний рядок
  oled.printf("BLE:%s WiFi:%s [1/3]", bleActive ? "ADV" : "OFF", wifiConnected ? "ON" : "OFF");     // Відображення стану зв'язку та номера сторінки
  oled.display();                                                                                   // Оновлення зображення на фізичній матриці дисплея
}                                                                                                   // Завершення відображення головного вікна

void drawSensors()                                        // Функція виведення первинних нескоригованих даних вимірювачів
{                                                         // Функція виведення первинних нескоригованих даних вимірювачів
  oled.clearDisplay();                                    // Очищення робочої площини перед виведенням інформації
  oled.setTextSize(1);                                    // Встановлення мінімального масштабу тексту для щільного компонування
  oled.setCursor(0, 0);                                   // Встановлення початкової точки для виведення назви сторінки
  oled.println(F("--- RAW SENSORS ---"));                 // Виведення верхнього маркувального підпису вікна
  oled.setCursor(0, 12);                                  // Позиціювання для друку прискорень по осях X та Y
  oled.printf("AX:%+5.1f AY:%+5.1f", ax, ay);             // Форматований друк поточних значень бічного прискорення
  oled.setCursor(0, 22);                                  // Перехід на рядок для осі Z та результуючої норми
  oled.printf("AZ:%+5.1f |A|:%.1f", az, accelMag);        // Виведення вертикального прискорення та евклідової магнітуди
  oled.setCursor(0, 34);                                  // Перехід на лінію відображення кутових швидкостей гіроскопа
  oled.printf("GX:%+5.1f GY:%+5.1f", gx, gy);             // Форматований вивід кутових швидкостей навколо осей X та Y
  oled.setCursor(0, 44);                                  // Перехід на друк обертання навколо Z та повної кутової норми
  oled.printf("GZ:%+5.1f |G|:%.1f", gz, gyroMag);         // Виведення обертання навколо Z та повної кутової магнітуди
  oled.drawLine(0, 52, 127, 52, SSD1306_WHITE);           // Проведення нижньої роздільної лінії інтерфейсу
  oled.setCursor(0, 55);                                  // Встановлення друку у підвал навігаційної смуги
  oled.printf("T:%.0fC HR:%d [2/3]", mpuTemp, heartRate); // Відображення температури, пульсу та індексу сторінки
  oled.display();                                         // Відображення оновленої графічної інформації на екрані
}                                                         // Завершення процедури малювання екрана сирих значень

void drawEnergy()                                         // Функція промальовування вікна рекомендацій енергозбереження
{                                                         // Функція промальовування вікна рекомендацій енергозбереження
