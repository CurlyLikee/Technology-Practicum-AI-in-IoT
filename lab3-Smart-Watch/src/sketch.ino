void updateDisplay()                           // Селектор вибору потрібного кадру відображення
{                                              // Відкриття селектора вибору кадру відображення
  if (!oledAvailable)                          // Перевірка доступності дисплея
    return;                                    // Блокування оновлення за відсутності зв'язку з екраном
  switch (screenIdx)                           // Вибір активного екрана за його індексом
  {                                            // Перемикання процедури малювання за індексом активного вікна
  case 0:                                      // Вибір головного екрана
    drawDashboard();                           // Відмальовування головного екрана
    break;                                     // Виклик відмальовки основного вікна моніторингу
  case 1:                                      // Вибір екрана сирих сенсорних даних
    drawSensors();                             // Відмальовування даних сенсорів
    break;                                     // Виклик процедури детальних вимірювань сенсорів
  case 2:                                      // Вибір екрана енергетичних порад
    drawEnergy();                              // Відмальовування енергетичних порад
    break;                                     // Виклик процедури виведення аналітики живлення
  }                                            // Завершення вибору вікна користувацького інтерфейсу
}                                              // Завершення головного диспетчера оновлення дисплея

void handleButton()                            // Функція реєстрації натискань тактової кнопки
{                                              // Відкриття процедури обробки натискань кнопки
  bool state = digitalRead(PIN_BUTTON);        // Зчитування поточного логічного рівня з контакту кнопки
  unsigned long now = millis();                // Отримання поточного значення системного лічильника мілісекунд

  if (state == LOW && lastBtnState == HIGH && (now - lastBtnMs > 250))        // Перевірка натискання з антибрязкотом
  {                                                                           // Перевірка спаду фронту сигналу із захистом від брязкоту
    screenIdx = (screenIdx + 1) % 3;                                          // Циклічне перемикання індексу сторінки в діапазоні від нуля до двох
    lastBtnMs = now;                                                          // Оновлення мітки часу останнього підтвердженого перемикання
    Serial.printf("\r[UI] Screen switched to -> %d/3\r\n", screenIdx + 1);    // Друк повідомлення про номер відкритого екрана
  }                                                                           // Завершення обробки підтвердженої дії перемикання
  lastBtnState = state;                                                       // Збереження поточного рівня контакту для наступного кроку порівняння
}                                                                             // Завершення обробки подій кнопки перемикання

void updateBLE() {                                                                                // Процедура періодичної передачі сповіщень спостерігачам
  if (!bleActive) return;                                                                         // Переривання виконання за умови неактивного стану радіотракту
  static unsigned long lastBleUpdate = 0;                                                         // Збереження часу відправки попереднього пакета між викликами
  if (millis() - lastBleUpdate > 1000) {                                                          // Перевірка настання інтервалу передачі тривалістю в одну секунду
    Serial.printf("\r[BLE NOTIFY] Act: %s | HR: %d BPM\r\n", activityName(activity), heartRate);  // Форматований вивід поточної активності та пульсу в консоль
    lastBleUpdate = millis();                                                                     // Оновлення часової позначки останньої успішної трансляції пакета
  }                                                                                               // Завершення блоку перевірки секундного інтервалу
}                                                                                                 // Завершення процедури періодичної передачі пакетів

void sendToThingSpeak()                                                         // Функція пакетної відправки метрик на хмарну платформу ThingSpeak
{                                                                               // Відкриття процедури передачі метрик у ThingSpeak
  if (!wifiConnected || WiFi.status() != WL_CONNECTED)                          // Перевірка активності бездротового з'єднання
    return;                                                                     // Переривання запиту за відсутності активного бездротового з'єднання

  WiFiClient client;                                                            // Створення клієнтського сокету для низькорівневого мережевого обміну
  if (!client.connect(TS_HOST, 80))                                             // Перевірка встановлення TCP з'єднання з сервером
  {                                                                             // Відкриття прямого TCP з'єднання до порту веб-сервера
    Serial.println(F("\r[ThingSpeak] connect failed"));                         // Виведення помилки за неможливості з'єднатися з хостом
    return;                                                                     // Дострокове завершення функції при невдалому підключенні
  }                                                                             // Завершення перевірки статусу підключення клієнта

  char path[160];                                                               // Буфер формування рядка запиту та передачі параметрів
  snprintf(path, sizeof(path),                                                  // Безпечне форматування адресного рядка із заповненням телеметрії
           "/update?api_key=%s&field1=%d&field2=%d&field3=%.2f&field4=%.2f",    // Шаблон заповнення полів телеметрії через параметри адреси
           TS_API_KEY, (int)activity, heartRate, accelMag, gyroMag);            // Передача ключа запису, типу активності, пульсу та сил прискорення

  client.printf("GET %s HTTP/1.0\r\nHost: %s\r\nConnection: close\r\n\r\n",     // Генерація заголовків стандартного запиту HTTP GET
                path, TS_HOST);                                                 // Підстановка сформованого шляху та імені цільового віддаленого сервера

  unsigned long start = millis();                                               // Засікання моменту початку очікування підтвердження відповіді
  while (client.connected() && millis() - start < 2000)                         // Очікування відповіді сервера з таймаутом
  {                                                                             // Цикл зчитування даних відповіді із двосекундним таймаутом
    while (client.available())                                                  // Перевірка наявності байтів у мережевому буфері
    {                                                                           // Зчитування вхідних байтів із мережевого буфера
      client.read();                                                            // Вичитування байта відповіді для повного очищення сокету
    }                                                                           // Завершення очищення доступного мережевого буфера
  }                                                                             // Завершення очікування закриття з'єднання сервером
  client.stop();                                                                // Примусовий розрив встановленого локального TCP з'єднання
  Serial.println(F("\r[ThingSpeak] telemetry published"));                      // Виведення підтвердження про передачу полів спостереження
}                                                                               // Завершення процедури надсилання даних у хмару

void updateEnergyAdvisor()                     // Функція оптимізації періоду роботи системи за порадами ШІ
{                                              // Відкриття процедури оптимізації періоду вимірювань
  unsigned long now = millis();                // Зчитування поточного часу роботи мікроконтролера
  if (now - lastTipChangeMs > 5000)            // Перевірка часу зміни поточної енергетичної поради
  {                                            // Перевірка настання інтервалу зміни поточної поради
    tipIdx = (tipIdx + 1) % NUM_TIPS;          // Інкремент покажчика для переходу до наступної поради в списку
    lastTipChangeMs = now;                     // Оновлення часу попередньої зміни активної поради
  }                                            // Завершення процедури циклічного перебору порад

  switch (activity)                            // Вибір періоду опитування за рівнем активності
  {                                            // Вибір періоду опитування сенсорів відповідно до рівня активності
  case ACTIVITY_IDLE:                          // Вибір режиму вимірювань для стану спокою
    sensorInterval = 500;                      // Встановлення півсекундного інтервалу опитування
    break;                                     // Збільшення паузи опитування до половини секунди у стані спокою
  case ACTIVITY_WALKING:                       // Вибір режиму вимірювань для ходьби
    sensorInterval = 200;                      // Встановлення помірного інтервалу опитування
    break;                                     // Встановлення помірного періоду опитування у стані ходьби
  case ACTIVITY_RUNNING:                       // Вибір режиму вимірювань для бігу
    sensorInterval = 100;                      // Встановлення частого інтервалу опитування
    break;                                     // Підвищення частоти вимірювань для точної фіксації бігу
  case ACTIVITY_FALL:                          // Вибір аварійного режиму вимірювань
    sensorInterval = 50;                       // Встановлення максимальної частоти опитування
    break;                                     // Максимальна частота дискретизації для аналізу аварійного падіння
  }                                            // Завершення динамічного регулювання інтервалу опитування датчиків
}                                              // Завершення блоку оптимізації режиму живлення

void setup()                                   // Головна процедура первинної конфігурації системи
{                                              // Відкриття процедури первинної конфігурації системи
  Serial.begin(115200);                        // Ініціалізація послідовного порту для обміну даними на швидкості 115200 біт на секунду
  delay(1000);                                 // Затримка для стабілізації перехідних процесів живлення

  Serial.println(F("\r================================="));                   // Виведення верхньої рамки початкового привітання
  Serial.println(F("\r Activity Tracker"));                                   // Виведення назви розробленого пристрою
  Serial.println(F("\r================================="));                   // Виведення нижньої рамки початкового привітання

  pinMode(PIN_BUTTON, INPUT_PULLUP);                                          // Конфігурація контакту кнопки на вхід із внутрішньою підтяжкою до живлення
  Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL);                                       // Старт апаратного контролера шини I2C на відповідних контактах

  initOLED();                                                                 // Виклик процедури запуску та базової розмітки екрана
  initMPU();                                                                  // Виклик процедури виявлення та налаштування сенсора прискорень
  initBLE();                                                                  // Виклик процедури розгортання бездротових сервісів передачі BLE
  initWiFi();                                                                 // Виклик процедури авторизації в локальній мережі Wi-Fi

  Serial.println(F("\r[SYSTEM] Ready!"));                                     // Сповіщення про завершення ініціалізації та повну готовність пристрою
}                                                                             // Завершення стартової процедури конфігурації

void loop()                                                                   // Головний нескінченний цикл роботи керуючої програми
{                                                                             // Відкриття головного циклу роботи програми
  unsigned long now = millis();                                               // Отримання поточної системної часової позначки

  handleButton();                                                             // Опитування стану тактової кнопки зміни поточного екрана

  if (now - lastSensorMs >= sensorInterval)                                   // Перевірка настання періоду опитування сенсорів
  {                                                                           // Перевірка настання періоду опитування вимірювальних пристроїв
    readSensors();                                                            // Зчитування поточних значень просторових сенсорів та пульсу

    classifier.addSample(ax, ay, az, gx, gy, gz);                             // Додавання нового вектора вимірювань у ковзне вікно класифікатора
    activity = classifier.classify();                                         // Запуск аналізу моделі TinyML для визначення поточного типу активності

    updateEnergyAdvisor();                                                    // Оновлення параметрів періоду вимірювань та порад оптимізації
    updateBLE();                                                              // Оновлення та трансляція свіжих показників через канал BLE
    lastSensorMs = now;                                                       // Оновлення часової позначки останнього вимірювання
  }                                                                           // Завершення періодичного циклу вимірювання та обробки рухів

  if (now - lastDisplayMs >= 100)                                             // Перевірка необхідності оновлення дисплея
  {                                                                           // Перевірка необхідності формування нового кадру на екрані
    updateDisplay();                                                          // Промальовування актуального вмісту на дисплеї
    lastDisplayMs = now;                                                      // Оновлення часової позначки виведення кадру
  }                                                                           // Завершення циклу періодичного оновлення екрана

  if (now - lastSerialMs >= 1000)                                                                         // Перевірка настання періоду виведення стану
  {                                                                                                       // Перевірка настання періоду щосекундного виведення стану
    Serial.printf("\r[STATE] Act: %-9s | HR: %3d | Accel: %5.2f | Gyro: %5.2f | Interval: %lums\r\n",     // Форматований друк телеметрії в термінал
                  activityName(activity), heartRate, accelMag, gyroMag, sensorInterval);                  // Підстановка змінних активності, пульсу, магнітуд та інтервалу
    lastSerialMs = now;                                                                                   // Оновлення часової позначки останнього друку в термінал
  }                                                                                                       // Завершення блоку щосекундного текстового моніторингу

  if (now - lastTsSendMs >= TS_INTERVAL)       // Перевірка необхідності передачі даних у хмару
  {                                            // Перевірка необхідності чергової вигрузки в хмару
    sendToThingSpeak();                        // Відправка сформованого пакета на сервер ThingSpeak
    lastTsSendMs = now;                        // Оновлення часової позначки попереднього мережевого запиту
  }                                            // Завершення блоку відправки хмарної телеметрії
  delay(10);                                   // Коротка апаратна пауза для розвантаження диспетчера задач
}                                              // Завершення головного нескінченного циклу програми