void initWiFi()                                           // Функція встановлення підключення до локальної мережі Wi-Fi
{                                                         // Функція встановлення підключення до локальної мережі Wi-Fi
  Serial.print(F("\r[WiFi] Connecting to "));             // Друк тексту спроби встановлення бездротового зв'язку
  Serial.print(WIFI_SSID);                                // Друк імені точки доступу в рядок консолі
  WiFi.mode(WIFI_STA);                                    // Переведення радіомодуля в режим клієнтської станції
  WiFi.begin(WIFI_SSID, WIFI_PASS);                       // Надсилання запиту асоціації до бездротової точки

  int tries = 0;                                          // Лічильник кількості здійснених спроб підключення
  while (WiFi.status() != WL_CONNECTED && tries < 15)     // Цикл очікування авторизації з обмеженням спроб
  {                                                       // Відкриття блоку очікування підключення
    delay(400);                                           // Затримка між перевірками результату з'єднання
    Serial.print(F("."));                                 // Відображення індикатора процесу встановлення зв'язку
    tries++;                                              // Інкремент кількості зроблених спроб
  }                                                       // Завершення циклічного опитування стану з'єднання

  Serial.println();                                       // Друк символу переводу рядка після серії крапок
  if (WiFi.status() == WL_CONNECTED)                      // Перевірка успішності підключення до мережі
  {                                                       // Перевірка успішності авторизації в бездротовій мережі
    wifiConnected = true;                                 // Фіксація встановлення зв'язку з локальною мережею
    Serial.print(F("\r[WiFi] Connected! IP: "));          // Друк підтвердження отримання внутрішньої адреси
    Serial.println(WiFi.localIP().toString());            // Виведення виділеної динамічної мережевої IP адреси
  }                                                       // Завершення обробки успішного підключення
  else                                                    // Обробка режиму без активної мережі
  {                                                       // Гілка за відсутності встановленого з'єднання
    Serial.println(F("\r[WiFi] Offline mode enabled"));   // Переведення системи в автономний локальний режим
  }                                                       // Завершення перевірки стану мережевого з'єднання
}                                                         // Завершення процедури запуску зв'язку Wi-Fi

void readSensors()                                        // Процедура вибірки та обробки телеметричних сигналів
{                                                         // Процедура вибірки та обробки телеметричних сигналів
  sensors_event_t a, g, t;                                // Структури даних для зберігання отриманих векторів вимірювань
  if (mpuAvailable)                                       // Перевірка доступності реального сенсора
  {                                                       // Перевірка активності реального апаратного сенсора
    mpu.getEvent(&a, &g, &t);                             // Зчитування останніх подій сенсорів із регістрів пристрою
    ax = a.acceleration.x;                                // Фіксація миттєвої проєкції лінійного прискорення на вісь X
    ay = a.acceleration.y;                                // Фіксація миттєвої проєкції лінійного прискорення на вісь Y
    az = a.acceleration.z;                                // Фіксація миттєвої проєкції лінійного прискорення на вісь Z
    gx = g.gyro.x;                                        // Фіксація швидкості радіального обертання навколо осі X
    gy = g.gyro.y;                                        // Фіксація швидкості радіального обертання навколо осі Y
    gz = g.gyro.z;                                        // Фіксація швидкості радіального обертання навколо осі Z
    mpuTemp = t.temperature;                              // Фіксація внутрішньої температури чутливого елемента

    accelMag = sqrtf(ax * ax + ay * ay + az * az);        // Розрахунок скалярної евклідової норми лінійного прискорення
    gyroMag = sqrtf(gx * gx + gy * gy + gz * gz);         // Розрахунок повної магнітуди вектора кутової швидкості
  }                                                       // Завершення зчитування апаратних вимірювань
  else                                                    // Перехід до резервних значень без сенсора
  {                                                       // Гілка генерації умовних даних за відсутності сенсора
    ax = 0.1f;                                            // Встановлення резервного прискорення по осі X
    ay = 0.2f;                                            // Встановлення резервного прискорення по осі Y
    az = 9.81f;                                           // Присвоєння базових координат статичної гравітації
    gx = 0.01f;                                           // Встановлення резервної кутової швидкості по осі X
    gy = 0.01f;                                           // Встановлення резервної кутової швидкості по осі Y
    gz = 0.0f;                                            // Присвоєння нульових швидкостей кутового дрейфу
    accelMag = 9.81f;                                     // Встановлення магнітуди прискорення вільного падіння
    gyroMag = 0.02f;                                      // Встановлення базового шуму кутової швидкості
  }                                                       // Завершення блоку отримання просторових векторів

  switch (activity)                                       // Вибір діапазону частоти пульсу залежно від активності
  {                                                       // Відкриття блоку вибору діапазону пульсу
  case ACTIVITY_IDLE:                                     // Обробка пульсу у стані спокою
    heartRate = 70 + (rand() % 10);                       // Генерація значень частоти серцебиття для спокою
    break;                                                // Завершення обробки стану спокою
  case ACTIVITY_WALKING:                                  // Обробка пульсу під час ходьби
    heartRate = 90 + (rand() % 15);                       // Генерація значень частоти серцебиття для ходьби
    break;                                                // Генерація значень частоти серцебиття для ходьби
  case ACTIVITY_RUNNING:                                  // Обробка пульсу під час бігу
    heartRate = 140 + (rand() % 20);                      // Генерація пульсу високої інтенсивності для бігу
    break;                                                // Генерація пульсу високої інтенсивності для бігу
  case ACTIVITY_FALL:                                     // Обробка пульсу під час падіння
    heartRate = 160 + (rand() % 20);                      // Формування показників тахікардії в момент падіння
    break;                                                // Формування показників тахікардії в момент падіння
  default:                                                // Обробка невизначеного стану активності
    heartRate = 75;                                       // Присвоєння нормальної середньої величини пульсу
  }                                                       // Завершення моделювання фізіологічного відгуку пульсометра
}                                                         // Завершення процедури опитування та моделювання даних

void drawDashboard()                              // Функція промальовування головного інформаційного екрана
{                                                 // Функція промальовування головного інформаційного екрана
  oled.clearDisplay();                            // Повне скидання попередніх пікселів у буфері екрана
  oled.setTextSize(1);                            // Встановлення стандартного розміру шрифту для шапки
  oled.setCursor(0, 0);                           // Позиціювання друку у верхній лівий кут екрана
  oled.println(F("-- Activity Tracker --"));      // Відображення головного заголовка робочого екрана

  oled.setTextSize(2);                            // Перемикання на подвійний шрифт для виділення результату
  oled.setCursor(0, 12);                          // Зсув друку для виведення статусу визначеного руху
  oled.println(activityName(activity));           // Виведення назви розпізнаної моделі активності

  oled.setTextSize(1);                            // Повернення шрифту до стандартного компактного розміру
