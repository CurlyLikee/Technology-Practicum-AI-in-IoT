void setup() {                                                                          // головна функція початкового налаштування мікроконтролера та периферії
  Serial.begin(115200);                                                                 // налаштування швидкості передачі даних головного послідовного порту
  Serial.println();                                                                     // виведення порожнього рядка для відокремлення системних повідомлень
  Serial.println("======================");                                             // виведення верхньої рамки назви системи у термінал
  Serial.println("AI VEHICLE MONITORING SYSTEM");                                       // виведення заголовка проекту в консоль
  Serial.println("======================");                                             // виведення нижньої рамки назви системи у термінал
  Serial.println("System starting...");                                                 // виведення повідомлення про початок завантаження
  Serial.println();                                                                     // виведення порожнього рядка для форматування тексту
  Serial2.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);                              // ініціалізація порту модуля навігації
  pinMode(TRIG_PIN, OUTPUT);                                                            // конфігурація піна імпульсу датчика відстані як виходу
  pinMode(ECHO_PIN, INPUT);                                                             // конфігурація піна прийому луни датчика відстані як входу
  ledcSetup(0, 2000, 8);                                                                // ініціалізація каналу генерації звукової частоти
  ledcAttachPin(BUZZER_PIN, 0);                                                         // закріплення виводу зумера за апаратним каналом
  ledcWriteTone(0, 0);                                                                  // початковий нульовий стан звукового випромінювача
  tft.begin();                                                                          // ініціалізація апаратного зв'язку з графічним контролером дисплея
  tft.setRotation(1);                                                                   // встановлення горизонтальної альбомної орієнтації зображення
  tft.fillScreen(ILI9341_BLACK);                                                        // очищення робочої області екрана чорним кольором
  tft.setTextColor(ILI9341_CYAN);                                                       // вибір бірюзового кольору для промальовування тексту
  tft.setTextSize(3);                                                                   // вибір великого масштабу шрифту для головного логотипа
  tft.setCursor(30, 70);                                                                // позиціонування курсора для відображення верхнього напису
  tft.println("ECO-DRIVE AI");                                                          // виведення назви інтелектуальної системи на дисплей
  tft.setTextSize(2);                                                                   // вибір середнього розміру шрифту для підзаголовка проекту
  tft.setTextColor(ILI9341_WHITE);                                                      // вибір білого контрастного кольору для тексту опису
  tft.setCursor(30, 115);                                                               // позиціонування текстового курсора для другого інформаційного рядка
  tft.println("On-Board Computer");                                                     // виведення назви пристрою бортового комп'ютера на дисплей
  tft.setTextColor(ILI9341_GREEN);                                                      // вибір приємного зеленого кольору для індикації статусу
  tft.setCursor(30, 150);                                                               // позиціонування курсора для виведення статусу ініціалізації
  tft.println("System starting...");                                                    // виведення повідомлення про перебіг завантаження на екран
  delay(1800);                                                                          // пауза для візуального сприйняття користувачем заставки старту
  connectToWiFi();                                                                      // виклик підпрограми підключення до бездротової мережі зв'язку
  aiAdvisor.begin();                                                                    // запуск внутрішнього алгоритму інтелектуального помічника водія
  drawDashboardLayout();                                                                // побудова статичних рамок та розмітки панелі приладів
  readSensors();                                                                        // первинне опитування всіх апаратних сенсорів системи
  aiAdvisor.processTelemetry(speed, distance);                                          // первинний аналіз параметрів руху модулем
  printConsoleStatus();                                                                 // первинне виведення поточної таблиці телеметрії в консоль
  lastSensorRead = millis();                                                            // ініціалізація таймера періодичного опитування датчиків
  lastDisplayUpdate = millis();                                                         // ініціалізація таймера регулярного оновлення дисплея
  lastThingSpeakUpdate = millis();                                                      // початковий відлік таймера хмарної синхронізації
  lastAiAdviceTime = millis();                                                          // ініціалізація таймера оновлення рекомендацій асистента
  lastConsoleStatusTime = millis();                                                     // ініціалізація таймера формування текстових звітів
}                                                                                       // завершення виконання функції початкового налаштування

void loop() {                                                                           // головний нескінченний цикл виконання робочих завдань мікроконтролера
  while (Serial2.available() > 0) {                                                     // цикл перевірки наявності байтів від модуля навігації
    char c = Serial2.read();                                                            // зчитування чергового байта послідовного потоку повідомлення
    gps.encode(c);                                                                      // передача отриманого байта у бібліотеку аналізу навігаційних речень
  }                                                                                     // завершення циклу обробки вхідного навігаційного потоку
  parkingSensor();                                                                      // виклик функції аналізу небезпечного наближення та генерації звуку
  if (millis() - lastSensorRead >= 300) {                                               // перевірка настання інтервалу опитування сенсорів
    readSensors();                                                                      // виклик оновлення показників датчика дистанції та навігатора
    aiAdvisor.processTelemetry(speed, distance);                                        // аналіз нової швидкості та дистанції модулем
    lastSensorRead = millis();                                                          // оновлення часової мітки останнього зняття вимірювань
  }                                                                                     // завершення блоку періодичного опитування датчиків
  if (millis() - lastAiAdviceTime >= AI_ADVICE_INTERVAL) {                              // перевірка інтервалу для нової поради
    aiAdvisor.updateAdvice(speed, distance);                                            // формування оновленого тексту поради водієві
    drawAiAdviceCard();                                                                 // перемальовування картки з новою підказкою на екрані
    lastAiAdviceTime = millis();                                                        // фіксація моменту останнього оновлення рекомендації
  }                                                                                     // завершення блоку періодичного оновлення порад
  if (millis() - lastConsoleStatusTime >= 2000) {                                       // перевірка інтервалу формування звіту в консоль
    printConsoleStatus();                                                               // виведення структурованої таблиці параметрів у термінал
    lastConsoleStatusTime = millis();                                                   // оновлення мітки часу останнього виведення звіту
  }                                                                                     // завершення блоку періодичного друку в консоль
  if (millis() - lastDisplayUpdate >= 400) {                                            // перевірка настання часу оновлення даних екрана
    updateDashboardValues();                                                            // перемальовування динамічних цифрових значень приладів
    lastDisplayUpdate = millis();                                                       // оновлення часової мітки останньої перемальовки екрана
  }                                                                                     // завершення блоку регулярного оновлення дисплея
  bool syncDue = millis() - lastThingSpeakUpdate >= THINGSPEAK_INTERVAL;                // перевірка настання інтервалу передачі даних
  if (wifiConnected && syncDue) {                                                       // перевірка наявності мережі та готовності до відправки
    sendToThingSpeak();                                                                 // виклик функції формування та відправки телеметрії в інтернет
    lastThingSpeakUpdate = millis();                                                    // збереження часу останнього успішного циклу відправки
  }                                                                                     // завершення блоку відправки хмарних даних
}                                                                                       // завершення головного робочого циклу програми

void connectToWiFi() {                                                                  // функція процедури підключення до точки бездротового доступу
  tft.fillScreen(ILI9341_BLACK);                                                        // заливка екрана чорним фоном перед виведенням статусу
  tft.setTextColor(ILI9341_YELLOW);                                                     // вибір жовтого кольору тексту для індикації очікування
  tft.setTextSize(2);                                                                   // вибір середнього розміру шрифту для читабельності повідомлення
  tft.setCursor(20, 80);                                                                // встановлення курсора у початкову точку виведення тексту
  tft.println("Connecting WiFi...");                                                    // виведення інформації про спробу підключення до мережі
  tft.setCursor(20, 110);                                                               // зміщення курсора на наступний інформаційний рядок екрана
  tft.print("SSID: ");                                                                  // виведення префікса назви мережі бездротового зв'язку
  tft.println(ssid);                                                                    // відображення назви цільової точки доступу на екрані
  WiFi.begin(ssid, password);                                                           // запуск процедури з'єднання з бездротовою мережею
  int attempts = 0;                                                                     // ініціалізація лічильника спроб очікування відповіді від роутера
  while (WiFi.status() != WL_CONNECTED && attempts < 15) {                              // цикл перевірки статусу з'єднання
    delay(400);                                                                         // апаратна пауза між періодичними опитуваннями стану зв'язку
    Serial.print(".");                                                                  // виведення крапки прогресу підключення у послідовний порт
    tft.print(".");                                                                     // дублювання символу крапки процесу очікування на екрані дисплея
    attempts++;                                                                         // збільшення лічильника здійснених спроб підключення
  }                                                                                     // завершення циклу перевірки стану з'єднання
  if (WiFi.status() == WL_CONNECTED) {                                                  // перевірка успішного встановлення зв'язку з мережею
    wifiConnected = true;                                                               // встановлення глобального прапорця наявності інтернет зв'язку
    Serial.println();                                                                   // виведення порожнього рядка для повернення каретки
    Serial.println("[WiFi] Connected! IP: " + WiFi.localIP().toString());               // повідомлення про успішне встановлення з'єднання
    tft.setTextColor(ILI9341_GREEN);                                                    // вибір зеленого кольору для успішного статусу зв'язку
    tft.setCursor(20, 150);                                                             // позиціонування курсора для повідомлення про успішне з'єднання
    tft.println("WiFi Connected!");                                                     // виведення підтвердження з'єднання на панель приладів
    tft.setCursor(20, 180);                                                             // позиціонування курсора для виведення мережевої адреси
    tft.print("IP: ");                                                                  // виведення префікса мережевої адреси на дисплей
    tft.println(WiFi.localIP());                                                        // виведення отриманої мережевої адреси мікроконтролера
  } else {                                                                              // гілка дій у разі вичерпання ліміту спроб з'єднання
    wifiConnected = false;                                                              // скидання прапорця зв'язку у значення відсутності інтернету
    Serial.println();                                                                   // виведення порожнього рядка для вирівнювання
    Serial.println("[WiFi] Running in offline simulation mode.");                       // повідомлення про роботу системи в автономному режимі
    tft.setTextColor(ILI9341_RED);                                                      // вибір червоного кольору для індикації помилки зв'язку
    tft.setCursor(20, 150);                                                             // позиціонування курсора для виведення офлайн статусу
    tft.println("WiFi Offline Mode");                                                   // виведення повідомлення про автономну роботу на дисплей
  }                                                                                     // завершення умовного блоку перевірки підключення
  delay(1200);                                                                          // пауза для ознайомлення користувача зі статусом мережі
}                                                                                       // завершення виконання підпрограми підключення до мережі

void readSensors() {                                                                    // функція опитування апаратних вимірювальних перетворювачів
  digitalWrite(TRIG_PIN, LOW);                                                          // встановлення початкового низького рівня на виводі пуску
  delayMicroseconds(2);                                                                 // мікросекундна пауза для гарантованого формування фронту
  digitalWrite(TRIG_PIN, HIGH);                                                         // подача високого рівня сигналу генерації зондувального ультразвуку
  delayMicroseconds(10);                                                                // формування імпульсу запуску тривалістю десять мікросекунд
  digitalWrite(TRIG_PIN, LOW);                                                          // повернення лінії запуску імпульсу в низький стан
  long duration = pulseIn(ECHO_PIN, HIGH, 26000);                                       // очікування та вимірювання тривалості сигналу відбитої хвилі
  if (duration == 0) {                                                                  // перевірка випадку неотримання відповіді відлуння сенсора
    distance = 400.0;                                                                   // присвоєння граничної максимальної вимірюваної відстані
  } else {                                                                              // випадок успішного прийому відбитої ультразвукової хвилі
    distance = (float)duration * 0.0343 / 2.0;                                          // розрахунок відстані в сантиметрах за формулою швидкості звуку
    if (distance > 400.0) distance = 400.0;                                             // відсікання значень що виходять за фізичні межі сенсора
  }                                                                                     // завершення блоку розрахунку дистанції далекоміра
  if (gps.location.isValid()) {                                                         // перевірка коректності та достовірності супутникових даних
    latitude = gps.location.lat();                                                      // збереження поточної координати географічної широти
    longitude = gps.location.lng();                                                     // збереження оновленої координати географічної довготи
  }                                                                                     // завершення перевірки координат геопозиціонування
  if (gps.speed.isValid()) {                                                            // перевірка актуальності показника швидкості від супутника
    speed = gps.speed.kmph();                                                           // зчитування швидкості автомобіля в кілометрах на годину
  } else {                                                                              // робота програмного генератора реалістичного профілю швидкості
    static unsigned long lastSimStep = 0;                                               // таймер перемикання кроків симуляції дорожнього циклу
    static int simPhase = 0;                                                            // індекс поточної активної фази імітаційного графіка руху
    if (millis() - lastSimStep > 2200) {                                                // перевірка інтервалу зміни поточної фази руху
      simPhase = (simPhase + 1) % 8;                                                    // циклічний перехід до наступного швидкісного етапу
      lastSimStep = millis();                                                           // оновлення часової мітки моменту перемикання етапу
    }                                                                                   // завершення блоку таймера зміни етапу симуляції
    switch (simPhase) {                                                                 // вибір значення швидкості відповідно до поточної фази циклу
      case 0: speed = 0.0; break;                                                       // імітація повної зупинки транспорту перед світлофором
      case 1: speed = 25.0; break;                                                      // плавний розгін та початок руху в щільному міському потоці
      case 2: speed = 58.0; break;                                                      // оптимальний розмірений швидкісний режим міської магістралі
      case 3: speed = 64.0; break;                                                      // динамічне прискорення в межах дозволеного міського ліміту
      case 4: speed = 96.0; break;                                                      // рух на високій швидкості по заміському шосе
      case 5: speed = 72.0; break;                                                      // комфортний крейсерський екологічний темп їзди трасою
      case 6: speed = 40.0; break;                                                      // поступове плавне сповільнення перед дорожнім перехрестям
      case 7: speed = 10.0; break;                                                      // повільне підкочування під час паркувального маневру
    }                                                                                   // завершення вибору швидкості для поточної фази
  }                                                                                     // завершення блоку програмного розрахунку швидкості
  tripDistance += (speed / 3600.0) * 0.3;                                               // інтегрування швидкості для нарощування сумарного кілометражу
}                                                                                       // завершення тіла функції опитування сенсорів

void parkingSensor() {                                                                  // функція звукового супроводу наближення до перешкод
  static unsigned long lastBeep = 0;                                                    // таймер збереження моменту попереднього звукового сигналу
  static bool buzzerActive = false;                                                     // прапорець активного стану звукового випромінювача
  unsigned long now = millis();                                                         // збереження поточного системного часу в мілісекундах
  if (distance < 30.0) {                                                                // перевірка попадання в зону критичної небезпеки зіткнення
    if (now - lastBeep > 140) {                                                         // генерація максимально частих тривожних імпульсів
      ledcWriteTone(0, 2500);                                                           // подача високого тону частотою дві з половиною тисячі герц
      buzzerActive = true;                                                              // встановлення ознаки подачі звукового сигналу
      lastBeep = now;                                                                   // оновлення мітки часу поданого звукового імпульсу
    } else if (buzzerActive && now - lastBeep > 80) {                                   // перевірка завершення тривалості короткого звукового імпульсу
      ledcWriteTone(0, 0);                                                              // вимкнення генерації тону після завершення імпульсу
      buzzerActive = false;                                                             // скидання прапорця активності звукового сигналу
    }                                                                                   // завершення блоку імпульсу критичної зони
  } else if (distance < 60.0) {                                                         // перевірка середньої дистанції підвищеної уваги
    if (now - lastBeep > 280) {                                                         // генерація попереджувальних імпульсів середньої частоти
      ledcWriteTone(0, 2000);                                                           // подача звукового тону частотою дві тисячі герц
      buzzerActive = true;                                                              // фіксація активності звукового сигналу
      lastBeep = now;                                                                   // збереження часу випромінювання звукового імпульсу
    } else if (buzzerActive && now - lastBeep > 100) {                                  // перевірка завершення звучання середнього імпульсу
      ledcWriteTone(0, 0);                                                              // вимкнення звукового сигналу після імпульсу
      buzzerActive = false;                                                             // скидання ознаки активності звуку
    }                                                                                   // завершення блоку імпульсу середньої зони
  } else if (distance < 100.0) {                                                        // перевірка далекої зони виявлення перешкоди
    if (now - lastBeep > 550) {                                                         // генерація рідкісних орієнтовних звукових клацань
      ledcWriteTone(0, 1500);                                                           // подача м'якого тону частотою півтори тисячі герц
      buzzerActive = true;                                                              // збереження ознаки відтворення звуку
      lastBeep = now;                                                                   // фіксація моменту подачі сигналу далекої зони
    } else if (buzzerActive && now - lastBeep > 120) {                                  // перевірка завершення звучання далекого імпульсу
      ledcWriteTone(0, 0);                                                              // припинення подачі тону далекої зони
      buzzerActive = false;                                                             // скидання статусу активності звуку
    }                                                                                   // завершення блоку імпульсу далекої зони
  } else {                                                                              // зона абсолютної безпеки понад сто сантиметрів
    if (buzzerActive) {                                                                 // перевірка необхідності одноразового вимкнення звуку
      ledcWriteTone(0, 0);                                                              // повне вимкнення звуку за відсутності перешкоди
      buzzerActive = false;                                                             // скидання прапорця активності звукового сигналу
    }                                                                                   // завершення блоку одноразового вимкнення
  }                                                                                     // завершення логіки багаторівневого звукового парктроніка
}                                                                                       // завершення тіла функції звукового парктроніка

void printStatusRow(const char *k1, const char *v1, const char *k2, const char *v2) {   // допоміжна функція форматованого друку рядка таблиці
  char row[96];                                                                         // буфер для формування вирівняного рядка таблиці
  snprintf(row, sizeof(row), "%-14s %-12s   %-14s %s", k1, v1, k2, v2);                 // форматування колонок таблиці телеметрії
  Serial.println(row);                                                                  // виведення сформованого рядка таблиці в консоль
}                                                                                       // завершення тіла функції виведення рядка таблиці

void printConsoleStatus() {                                                             // функція форматування та виведення звіту телеметрії в термінал
  char val1[16];                                                                        // буфер для збереження текстового представлення першого показника
  char val2[32];                                                                        // буфер для форматованого запису другого виміряного показника
  Serial.println();                                                                     // друк порожнього рядка для візуального відділення блоків інформації
  Serial.println("SYSTEM TELEMETRY");                                                   // виведення головного заголовка телеметричного звіту
  Serial.println();                                                                     // виведення порожнього рядка перед таблицею параметрів
  snprintf(val1, sizeof(val1), "%4.1f km/h", speed);                                    // форматування поточної швидкості
  float curAccel = aiAdvisor.getAcceleration();                                         // отримання поточної величини прискорення
  snprintf(val2, sizeof(val2), "%4.1f km/h/s", curAccel);                               // форматування розгону
  printStatusRow("Speed:", val1, "Accel:", val2);                                       // виведення сформованого рядка швидкості та прискорення
  snprintf(val1, sizeof(val1), "%d cm", (int)distance);                                 // форматування виміряної дистанції
  const char* obsStr = "SAFE";                                                          // базовий текстовий статус безпечного оточення
  if (distance < 30.0) obsStr = "STOP! CRITICAL";                                       // статус критичного наближення
  else if (distance < 60.0) obsStr = "WARNING";                                         // статус небезпечного зближення
  else if (distance < 100.0) obsStr = "CAUTION";                                        // статус попередження про перешкоду
  printStatusRow("Distance:", val1, "Obstacle:", obsStr);                               // виведення дистанції та попередження про перешкоду
  snprintf(val1, sizeof(val1), "%d%%", (int)aiAdvisor.getEcoScore());                   // форматування балу екології
  const char *driveState = aiAdvisor.getStateName();                                    // отримання текстового найменування стану водіння
  printStatusRow("AI Eco-Score:", val1, "Drive State:", driveState);                    // виведення оцінки водіння та стану асистента
  snprintf(val1, sizeof(val1), "%4.2f km", tripDistance);                               // форматування накопиченого пробігу
  const char *wfStr = wifiConnected ? "ONLINE" : "OFFLINE";                             // текстовий статус з єднання з бездротовою мережею
  const char *gpsStr = gps.location.isValid() ? "FIX" : "SIM";                          // текстовий статус фіксації супутникового сигналу
  snprintf(val2, sizeof(val2), "WiFi: %s | GPS: %s", wfStr, gpsStr);                    // форматування комбінованого мережевого статусу
  printStatusRow("Trip:", val1, "Network:", val2);                                      // виведення показників пробігу та стану зв язку
  unsigned long timeSinceCloud = millis() - lastThingSpeakUpdate;                       // розрахунок часу що минув від останньої відправки
  int secondsLeft = (THINGSPEAK_INTERVAL - timeSinceCloud) / 1000;                      // розрахунок кількості секунд до нової відправки
  if (secondsLeft < 0) secondsLeft = 0;                                                 // запобігання відображенню від'ємного часу
  snprintf(val1, sizeof(val1), "in %ds", secondsLeft);                                  // форматування зворотного відліку
  printStatusRow("Cloud Sync:", val1, "Server:", "ThingSpeak IoT");                     // виведення статусу хмарної синхронізації
  Serial.println();                                                                     // виведення порожнього рядка для розділення інформаційних блоків
  Serial.println("AI Driving Advice:");                                                 // заголовок секції порад інтелектуального помічника
  Serial.println(aiAdvisor.getAdvice());                                                // виведення актуального тексту підказки водієві
  Serial.println();                                                                     // завершальний порожній рядок блоку звіту телеметрії
}                                                                                       // завершення тіла функції виведення статусу в консоль

