    tft.setTextColor(ILI9341_RED);                                                      // червоний колір для позначення небезпечного перевищення
  } else if (speed > 80.0 || (speed < 20.0 && speed > 0.0)) {                           // перевірка наближення до ліміту або занадто повільного руху
    tft.setTextColor(ILI9341_YELLOW);                                                   // жовтий колір для привернення уваги водія на дорозі
