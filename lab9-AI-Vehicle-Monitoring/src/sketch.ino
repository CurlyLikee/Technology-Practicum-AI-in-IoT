  }                                                                                     // завершення блоку виведення мережевого стану
  tft.fillRect(10, 52, 88, 48, ILI9341_BLACK);                                          // очищення поля виведення цифрового значення швидкості
  tft.setTextSize(4);                                                                   // перехід на великий шрифт для швидкого сприйняття швидкості
