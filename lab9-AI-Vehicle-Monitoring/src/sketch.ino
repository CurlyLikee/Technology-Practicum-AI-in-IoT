  tft.setCursor(14, 56);                                                                // встановлення курсора для виведення цілого числа швидкості
  tft.print((int)speed);                                                                // друк розрахованої швидкості автомобіля на панелі
  tft.fillRect(116, 52, 88, 48, ILI9341_BLACK);                                         // стирання попередніх даних блоку оцінки водіння
  float currentScore = aiAdvisor.getEcoScore();                                         // зчитування поточного значення накопиченого рейтингу водія
