  tft.setTextSize(1);                                                                   // встановлення стандартного розміру системного шрифту
  tft.setTextColor(ILI9341_WHITE);                                                      // контрастний білий колір для технічних параметрів
  tft.setCursor(14, 120);                                                               // позиціонування курсора для першого рядка навігаційних даних
  tft.print("Trip: ");                                                                  // друк мітки накопиченого кілометражу поїздки
  tft.print(tripDistance, 2);                                                           // виведення значення пройденого шляху з двома знаками дробу
  tft.print(" km | Accel: ");                                                           // друк роздільника та префікса розрахованого прискорення
  float currentAccel = aiAdvisor.getAcceleration();                                     // отримання актуального динамічного прискорення
  if (currentAccel > 0.1) tft.print("+");                                               // друк знака плюс для позитивного розгону машини
  tft.print(currentAccel, 1);                                                           // відображення величини прискорення з точністю десятих
  tft.print(" m/s2");                                                                   // друк одиниці вимірювання фізичного прискорення
  tft.setCursor(14, 134);                                                               // перехід на другий інформаційний рядок для виведення GPS
  tft.print("GPS: ");                                                                   // виведення заголовка блоку супутникових координат
  if (gps.location.isValid()) {                                                         // перевірка достовірності отриманого сигналу супутників
    tft.print(latitude, 4);                                                             // виведення координати широти з чотирма знаками дробу
    tft.print(", ");                                                                    // розділовий символ між координатами широти та довготи
    tft.print(longitude, 4);                                                            // друк довготи поточного положення на місцевості
  } else {                                                                              // випадок відсутності фіксації супутникового сигналу
    tft.setTextColor(ILI9341_ORANGE);                                                   // помаранчевий колір попередження про пошук супутників
    tft.print("Acquiring Satellites... Sim Active");                                    // повідомлення про процес синхронізації супутників
  }                                                                                     // завершення блоку відображення координат супутника
}                                                                                       // завершення процедури динамічного оновлення екрана

void drawAiAdviceCard() {                                                               // функція відмальовування картки з рекомендацією водієві на екрані
  tft.fillRect(6, 178, 308, 52, ILI9341_BLACK);                                         // стирання попереднього тексту поради всередині рамки
  tft.setTextSize(1);                                                                   // вибір звичайного масштабу шрифту для читання підказки
  DriveState state = aiAdvisor.getState();                                              // зчитування поточного машинного стану динаміки авто
  switch (state) {                                                                      // вибір індикаторного кольору відповідно до рівня загрози
    case DRIVE_HARSH_ACCEL:                                                             // різкий набір швидкості водієм на ділянці
    case DRIVE_HARSH_BRAKE:                                                             // різке аварійне гальмування автомобіля
      tft.setTextColor(ILI9341_YELLOW);                                                 // жовтий колір попередження про неекологічну дію
      break;                                                                            // вихід з блоку оператора вибору кольору
    case DRIVE_TAILGATING:                                                              // небезпечне зближення з попереднім автомобілем
    case DRIVE_HIGH_SPEED:                                                              // перевищення безпечного ліміту швидкості
      tft.setTextColor(ILI9341_RED);                                                    // червоний колір критичної небезпеки та ризику
      break;                                                                            // вихід з блоку оператора вибору кольору
    case DRIVE_IDLING:                                                                  // тривала робота двигуна без руху автомобіля
      tft.setTextColor(ILI9341_ORANGE);                                                 // помаранчевий колір попередження про перевитрату пального
      break;                                                                            // вихід з блоку оператора вибору кольору
    case DRIVE_OPTIMAL_ECO:                                                             // зразкове плавне керування транспортним засобом
    default:                                                                            // базовий оптимальний режим руху за замовчуванням
      tft.setTextColor(ILI9341_GREEN);                                                  // зелений колір схвалення стилю керування
      break;                                                                            // вихід з блоку оператора вибору кольору
  }                                                                                     // завершення процедури вибору кольору картки
  tft.setCursor(12, 180);                                                               // встановлення початкових координат виведення статусу
  tft.print("STATUS: ");                                                                // текстовий префікс виведення режиму роботи асистента
  tft.println(aiAdvisor.getStateName());                                                // друк назви зафіксованого динамічного стану
  tft.setTextColor(ILI9341_WHITE);                                                      // білий колір для основного тексту рекомендації
  String text = aiAdvisor.getAdvice();                                                  // отримання сформованого тексту поради від помічника
  int curY = 196;                                                                       // початкова вертикальна координата для виведення тексту
  int startIdx = 0;                                                                     // індекс початку поточної виділеної частини рядка
  while (startIdx < text.length() && curY < 225) {                                      // цикл розбиття тексту поради на рядки за розміром картки
    int lineLen = 38;                                                                   // максимальна місткість символів в одному екранному рядку
    if (startIdx + lineLen >= text.length()) {                                          // перевірка чи вміщується залишок текстового повідомлення
      lineLen = text.length() - startIdx;                                               // призначення довжини за фактичною кількістю символів
    } else {                                                                            // пошук позиції пробілу для виключення розриву слів
      int spaceIdx = text.lastIndexOf(' ', startIdx + lineLen);                         // пошук останнього пробілу перед межею рядка
      if (spaceIdx > startIdx) {                                                        // перевірка знаходження коректного роздільника слів
        lineLen = spaceIdx - startIdx;                                                  // корекція довжини для уникнення розриву слова
      }                                                                                 // завершення корекції довжини рядка по слову
    }                                                                                   // завершення розрахунку довжини поточного рядка
    String line = text.substring(startIdx, startIdx + lineLen);                         // вирізання чергового рядка відформатованого тексту
    line.trim();                                                                        // видалення зайвих пробільних символів на початку та в кінці фрагмента
    tft.setCursor(12, curY);                                                            // встановлення координат для друку поточного рядка на дисплеї
    tft.print(line);                                                                    // виведення відформатованого рядка рекомендації водієві на екран
    startIdx += lineLen;                                                                // переміщення вказівника на наступну частину вхідного тексту
    if (startIdx < text.length() && text.charAt(startIdx) == ' ') startIdx++;           // пропуск пробілу перед наступним словом
    curY += 16;                                                                         // збільшення координати висоти для переходу на наступний рядок
  }                                                                                     // завершення циклу переносу слів повідомлення
}                                                                                       // завершення тіла функції формування картки порад помічника

void sendToThingSpeak() {                                                               // функція відправки зібраної телеметрії на хмарний сервер
  if (WiFi.status() != WL_CONNECTED) {                                                  // перевірка активного підключення до бездротової мережі
    wifiConnected = false;                                                              // скидання прапорця наявності зв'язку
    Serial.println("[ThingSpeak] WiFi disconnected, reconnecting...");                  // повідомлення про спробу повторного підключення
    WiFi.reconnect();                                                                   // ініціалізація процедури повторного підключення до мережі
    return;                                                                             // вихід якщо відсутнє з'єднання з бездротовою мережею
  }                                                                                     // закриття блоку перевірки підключення до мережі
  wifiConnected = true;                                                                 // підтвердження активного статусу підключення до інтернету
  HTTPClient http;                                                                      // створення локального екземпляра клієнта мережевих запитів
  String url = String(thingSpeakServer) + "?api_key=" + apiKey;                         // формування адреси запиту
  url += "&field1=" + String(speed, 1);                                                 // додавання значення поточної швидкості автомобіля
  url += "&field2=" + String(distance, 0);                                              // додавання виміряної дистанції до перешкоди
  url += "&field3=" + String(aiAdvisor.getEcoScore(), 1);                               // додавання балу стилю водіння
  url += "&field4=" + String(tripDistance, 2);                                          // додавання накопиченого кілометражу поїздки
  url += "&field5=" + String(latitude, 6);                                              // додавання географічної широти автомобіля
  url += "&field6=" + String(longitude, 6);                                             // додавання географічної довготи автомобіля
  Serial.println();                                                                     // виведення порожнього рядка для естетичного оформлення виведення
  Serial.println("[ThingSpeak] Uploading telemetry to cloud...");                       // повідомлення про відправку
  http.setTimeout(12000);                                                               // встановлення максимального часу очікування дванадцять секунд
  if (http.begin(url)) {                                                                // ініціалізація мережевого запиту за прямою веб адресою
    int httpCode = http.GET();                                                          // виконання мережевого запиту передачі телеметричних параметрів
    if (httpCode == 200) {                                                              // перевірка успішного коду прийняття пакета сервером
      String resp = http.getString();                                                   // зчитування номера створеного запису у каналі сервісу
      Serial.println("[ThingSpeak] Cloud update success! Entry #" + resp);              // підтвердження успішного завантаження даних
    } else if (httpCode > 0) {                                                          // обробка числових кодів помилок відповіді від сервера
      Serial.println("[ThingSpeak] HTTP Code: " + String(httpCode));                    // виведення числового коду помилки сервера
    } else {                                                                            // випадок збою мережевого з'єднання або таймауту
      Serial.println("[ThingSpeak] Connection: " + http.errorToString(httpCode));       // виведення розшифрованого текстового опису помилки
    }                                                                                   // завершення аналізу коду помилки
    http.end();                                                                         // закриття поточного сеансу та звільнення задіяних системних ресурсів
  } else {                                                                              // випадок неможливості ініціалізації клієнта
    Serial.println("[ThingSpeak] Failed to connect to server.");                        // сповіщення про неможливість відкриття з'єднання
  }                                                                                     // закриття блоку помилки ініціалізації
  Serial.println();                                                                     // виведення фінального порожнього рядка після циклу синхронізації
}                                                                                       // завершення тіла функції вивантаження телеметрії на хмарний сервер