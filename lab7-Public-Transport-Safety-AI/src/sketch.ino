const char *password = "";                                        // порожній пароль доступу до віртуальної точки
const char *thingSpeakApiKey = "BP5ABTDS19CG598I";                // персональний ключ запису каналу хмарної платформи
const char *thingSpeakUrl = "http://api.thingspeak.com/update";   // адреса мережевого шлюзу для надсилання телеметрії

const int pirPin = 4;                                             // номер цифрового виводу сенсора присутності людей
const int ledPin = 2;                                             // номер цифрового виводу світлодіода тривоги
const int co2PotPin = 34;                                         // номер аналогового виводу регулятора вуглекислого газу
const int vocPotPin = 35;                                         // номер аналогового виводу регулятора летких сполук
